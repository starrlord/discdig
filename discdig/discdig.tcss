/* discdig - amber-phosphor palette over a near-black ground.
   Every colour is a theme variable so the built-in themes (and the command
   palette's theme picker) restyle the whole app coherently. */

Screen {
    background: $background;
    color: $foreground;
    layers: base overlay;
}

/* ------------------------------------------------------------------ chrome */

#topbar {
    height: 1;
    background: $panel;
    color: $foreground;
}
#topbar > .brand {
    width: auto;
    padding: 0 1;
    background: $primary;
    color: $background;
    text-style: bold;
}
#topbar > .context {
    width: 1fr;
    padding: 0 1;
    color: $text-muted;
    content-align: left middle;
}
#topbar > .stats {
    width: auto;
    padding: 0 1;
    content-align: right middle;
}

#tabbar {
    height: 1;
    background: $surface;
}
#tabbar > .tab {
    width: auto;
    padding: 0 2;
    color: $text-muted;
}
#tabbar > .tab:hover {
    background: $boost;
    color: $foreground;
}
#tabbar > .tab.-active {
    background: $primary;
    color: $background;
    text-style: bold;
}
#tabbar > .spacer {
    width: 1fr;
}
#tabbar > .hint {
    width: auto;
    padding: 0 1;
    color: $text-disabled;
}

/* ------------------------------------------------------------------ panes */

#body {
    height: 1fr;
}

.pane {
    height: 1fr;
    width: 1fr;
}

.split {
    height: 1fr;
}

DataTable {
    height: 1fr;
    width: 1fr;
    background: $background;
    scrollbar-size-vertical: 1;
}
DataTable > .datatable--header {
    background: $surface;
    color: $text-muted;
    text-style: none;
}
DataTable > .datatable--cursor {
    background: $primary 30%;
    color: $foreground;
    text-style: bold;
}
DataTable:focus > .datatable--cursor {
    background: $primary;
    color: $background;
}

/* --------------------------------------------------------------- detail */

#detail {
    /* Proportional so a narrow terminal keeps a usable table beside it. */
    width: 40%;
    min-width: 28;
    max-width: 52;
    height: 1fr;
    background: $surface;
    border-left: vkey $primary-darken-2;
    padding: 0 1;
    display: none;
}
#detail.-visible {
    display: block;
}
#detail .title {
    color: $primary;
    text-style: bold;
}
#detail .label {
    color: $text-muted;
}

/* --------------------------------------------------------------- browse */

#crumbs {
    height: 1;
    padding: 0 1;
    background: $surface;
    color: $secondary;
}

/* --------------------------------------------------------------- search */

/* One-row controls throughout: bordered inputs are three rows tall each, which
   turned the filter panel into half the screen. */
#searchbar {
    height: 1;
    padding: 0 1;
}
#mode-switch {
    width: auto;
    height: 1;
    margin-right: 1;
}
#searchbar Input {
    width: 1fr;
    border: none;
    height: 1;
    padding: 0 1;
    background: $surface;
    color: $foreground;
}
#searchbar Input:focus {
    background: $panel;
    border-left: thick $primary;
}
#searchbar .status {
    width: auto;
    padding: 0 1;
    color: $text-muted;
    content-align: right middle;
}

#filters {
    height: auto;
    background: $surface;
    border-bottom: solid $primary-darken-3;
    padding: 0 1;
    display: none;
}
#filters.-visible {
    display: block;
}
#filters .row {
    height: 1;
    margin-bottom: 1;
}
#filters Label {
    width: 11;
    color: $text-muted;
    text-align: right;
    padding: 0 1 0 0;
}
#filters Input {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0 1;
    background: $background;
    color: $foreground;
    margin-right: 2;
}
#filters Input:focus {
    background: $panel;
    border-left: thick $primary;
}
#filters Select {
    width: 1fr;
    height: 1;
    margin-right: 2;
}
#filters Checkbox {
    width: auto;
    height: 1;
    border: none;
    background: $surface;
    margin-right: 3;
}

/* ---------------------------------------------------------------- queue */

#queuehead {
    height: 4;
    background: $surface;
    padding: 0 1;
    border-bottom: solid $primary-darken-3;
}
#queuehead .figures {
    height: 1;
}
#queuehead .figure {
    width: 1fr;
}
#queuehead ProgressBar {
    width: 1fr;
    height: 1;
}
#queuehead Bar > .bar--bar {
    color: $success;
}
#queuehead Bar > .bar--complete {
    color: $success;
}

/* --------------------------------------------------------------- modals */

ModalScreen {
    align: center middle;
    background: $background 70%;
}

.dialog {
    background: $surface;
    border: round $primary;
    padding: 1 2;
    width: 78;
    max-width: 96%;
    height: auto;
    max-height: 90%;
}
.dialog > .heading {
    color: $primary;
    text-style: bold;
    margin-bottom: 1;
}
.dialog .buttons {
    height: 3;
    align-horizontal: right;
    margin-top: 1;
}
.dialog Button {
    margin-left: 2;
    min-width: 12;
}

#help-body {
    height: auto;
    max-height: 30;
}

#settings-form Label {
    width: 18;
    padding: 1 1 0 0;
    color: $text-muted;
    text-align: right;
}
#settings-form .row {
    height: 3;
}
#settings-form Input {
    width: 1fr;
}
#settings-form Select {
    width: 1fr;
}

Toast {
    width: 60;
}

LoadingIndicator {
    background: $background 40%;
}
